{
  "pgsql_host": "localhost",
  "pgsql_port": 5432,
  "pgsql_user": "YOUR_POSTGRES_USER",
  "pgsql_password": "YOUR_POSTGRES_PASSWORD",
  "pgsql_database": "anki",
  "pgsql_schema": "public",
  "log_path": "batch_logs",
  "pgsql_kanji_table": "anki_kanji",
  "pgsql_word_table": "anki_word",
  "pgsql_batch_job_table": "batch_jobs",
  "pgsql_ssl_mode": "disable",
  "pgsql_ssl_ca": "",
  "pgsql_connect_timeout": 15,
  "services": {
    "image_generator": {
      "image_api_base": "http://localhost:18610/v1",
      "image_api_key": "YOUR_IMAGE_API_KEY",
      "image_model": "muse-image-1.0",
      "image_size": "1024x1024",
      "image_field": "Image",
      "skip_existing_image": false,
      "timeout_seconds": 240,
      "limit": null,
      "step": 10,
      "job_type": "image_generate",
      "clean_error": true,
      "upload_provider": "local",
      "image_base_path": "",
      "media_dir": "/path/to/collection.media"
    },
    "word_generator": {
      "limit": null,
      "overwrite_existing_fields": false,
      "skip_fields": {
        "word": [],
        "kanji": []
      },
      "chat_api_base": "YOUR_CHAT_API_BASE",
      "chat_api_key": "YOUR_CHAT_API_KEY",
      "chat_model": "YOUR_CHAT_MODEL",
      "source_language": "Japanese",
      "destination_language": "Vietnamese",
      "user_level": "N3",
      "temperature": 0.2,
      "timeout_seconds": 120
    },
    "tts_generator": {
      "api_base": "YOUR_TTS_API_BASE",
      "api_key": "YOUR_TTS_API_KEY",
      "model": "edge-tts/ja-JP-KeitaNeural",
      "timeout_seconds": 120
    },
    "spreadsheet_anki_creator": {
      "skip_images": true,
      "skip_tts": true
    },
    "anki_notes": {
      "job_type": "anki_notes",
      "log_dir": "batch_logs",
      "limit": null,
      "sync_before_processing": false,
      "sync_after_processing": false
    },
    "watcher": {
      "jobs": [
        {
          "script": "batch/anki_notes.py",
          "interval": "5m",
          "args": ["--skip-images", "--skip-sync"]
        },
        {
          "script": "batch/images.py",
          "interval": "5m",
          "args": ["--skip-sync"]
        }
      ]
    }
  },
  "anki_import": {
    "api_url": "http://127.0.0.1:8765",
    "note_types": {
      "word": "YOUR_WORD_NOTE_TYPE",
      "kanji": "YOUR_KANJI_NOTE_TYPE"
    }
  }
}
